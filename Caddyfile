# Servidor del sitio en Railway. El HTTPS lo pone Railway (certificado automático),
# así que aquí Caddy solo atiende HTTP en el puerto que Railway indica con PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Archivos de configuración y del repositorio: no se publican.
	@private path /Caddyfile /Dockerfile /README.md /.dockerignore /.git /.git/*
	respond @private 404

	# www.tudominio.com → tudominio.com (una sola dirección para el sitio)
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# El navegador recuerda un año que este sitio solo se abre por HTTPS.
		Strict-Transport-Security "max-age=31536000"
		# Solo se cargan archivos del propio sitio: nada en línea ni de terceros.
		# 'wasm-unsafe-eval', blob: y data: son para el visor 3D (model-viewer).
		# Si se agrega un script o estilo en línea, o algo de otro dominio, hay que permitirlo aquí.
		# El sha256 de style-src es el estilo que inyecta vendor/model-viewer.min.js: si se
		# actualiza ese archivo, la consola del navegador indicará la huella nueva.
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'sha256-PXtZZkJMMyc18o/DN1ZEFOJ2qEGq95IQbVaJFMOXOb0='; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Las páginas siempre se revisan; CSS y JS llevan ?v= en los enlaces y se guardan
	# un año; imágenes, fuentes y modelos, un día.
	@html path / *.html
	header @html Cache-Control "no-cache"
	@code path *.css *.js
	header @code Cache-Control "public, max-age=31536000, immutable"
	@media path /assets/* /vendor/*
	header @media Cache-Control "public, max-age=86400"

	file_server
}
